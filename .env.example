# 运行环境：生产环境设置为 production
NODE_ENV=

# 服务监听端口（Render 通常会自动提供）
PORT=

# 正式前端来源；多个来源用逗号分隔，例如 https://example.com
FRONTEND_ORIGIN=

# Supabase 连接配置
SUPABASE_URL=
SUPABASE_KEY=

# Haven-Ombre Gateway（虚构示例地址：https://gateway.example.invalid/v1）
OMBRE_GATEWAY_BASE_URL=
OMBRE_GATEWAY_TOKEN=
OMBRE_GATEWAY_MODEL=

# 浏览器可选择的 Haven 安全公开别名，逗号分隔；不得填写 URL、密钥或真实上游模型名。
# 默认模型始终由 OMBRE_GATEWAY_MODEL 指定；所有公开别名必须以 cc-home- 开头。
CC_HOME_ALLOWED_MODEL_ALIASES=cc-home-default,cc-home-claude-sonnet,cc-home-claude-opus

# Gateway 请求超时（毫秒，默认 30000）
OMBRE_GATEWAY_TIMEOUT_MS=

# 内部烟测专用 Gateway session；不读取或保存用户主聊天数据
CC_HOME_SMOKE_SESSION_ID=cc-home-smoke

# 管理员接口密钥；仅保存在后端环境中
ADMIN_TOKEN=

# Supabase Auth 中唯一允许使用聊天功能的用户 UUID（示例为无效占位值）
# 当前仅允许一个用户；应用还会通过 sessions.user_id 校验唯一 main session 所有权。
CHAT_ALLOWED_USER_ID=00000000-0000-0000-0000-000000000000

# 仅供服务端烟雾测试使用的长期内部凭证；通过 X-CC-Home-Internal-Token 发送。
# 不得返回浏览器、写入 Vite 环境变量、前端存储、构建产物或日志。
CHAT_ACCESS_TOKEN=

# /chat 基础滥用防护配置
CHAT_RATE_LIMIT_WINDOW_MS=
CHAT_RATE_LIMIT_MAX=
CHAT_MAX_MESSAGE_LENGTH=

# 历史接口最多返回的消息数（默认 100，硬上限 200）
CHAT_HISTORY_MAX_MESSAGES=
