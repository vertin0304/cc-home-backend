# 运行环境：生产环境设置为 production
NODE_ENV=

# 服务监听端口（Render 通常会自动提供）
PORT=

# 正式前端来源；多个来源用逗号分隔，例如 https://example.com
FRONTEND_ORIGIN=

# Supabase 连接配置
SUPABASE_URL=
SUPABASE_KEY=

# 默认 AI 接口配置
BASE_URL=
API_KEY=
MODEL_NAME=

# 可选：允许管理员配置的 AI 接口来源；多个来源用逗号分隔
AI_BASE_URL_ALLOWLIST=

# Ombre Brain MCP 地址
OMBRE_BRAIN_URL=

# 管理员接口密钥；仅保存在后端环境中
ADMIN_TOKEN=

# /chat 基础滥用防护配置
CHAT_RATE_LIMIT_WINDOW_MS=
CHAT_RATE_LIMIT_MAX=
CHAT_MAX_MESSAGE_LENGTH=
