# 运行环境：生产环境设置为 production
NODE_ENV=

# 服务监听端口（Render 通常会自动提供）
PORT=

# 正式前端来源；多个来源用逗号分隔，例如 https://example.com
FRONTEND_ORIGIN=

# Supabase 连接配置
SUPABASE_URL=
SUPABASE_KEY=

# Haven-Ombre Gateway（虚构示例地址：https://gateway.example.invalid/v1）
OMBRE_GATEWAY_BASE_URL=
OMBRE_GATEWAY_TOKEN=
OMBRE_GATEWAY_MODEL=

# Gateway 请求超时（毫秒，默认 30000）
OMBRE_GATEWAY_TIMEOUT_MS=

# 前端未提供 sessionId 时使用的稳定后备值
CC_HOME_DEFAULT_SESSION_ID=cc-home-main

# 管理员接口密钥；仅保存在后端环境中
ADMIN_TOKEN=

# 生产环境 /chat 独立访问密钥；客户端通过 Authorization: Bearer 发送
CHAT_ACCESS_TOKEN=

# /chat 基础滥用防护配置
CHAT_RATE_LIMIT_WINDOW_MS=
CHAT_RATE_LIMIT_MAX=
CHAT_MAX_MESSAGE_LENGTH=
